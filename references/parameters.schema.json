{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Argo CD extension generation parameters",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "argoCdVersion",
    "profile"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 60
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "argoCdVersion": {
      "const": "3.5.1"
    },
    "profile": {
      "const": "top-bar-action-menu"
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 60
        },
        "iconClassName": {
          "type": "string",
          "maxLength": 80
        },
        "isMiddle": {
          "type": "boolean"
        }
      },
      "default": {}
    },
    "dataSource": {
      "const": "host-props",
      "default": "host-props"
    }
  }
}
